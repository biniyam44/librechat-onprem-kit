# Settings this kit adds or changes. Merge them into LibreChat's .env
# (start from LibreChat's own .env.example). Never commit the real .env.
# Values marked CHANGE are company-specific. Empty secrets must be generated
# (for example with: openssl rand -hex 32).

#==============================#
# Images and network           #
#==============================#
# Pin the API image to a digest so updates only happen when IT chooses (see docs/runbook.md).
LIBRECHAT_API_IMAGE=registry.librechat.ai/librechat-ai/librechat-dev-api@sha256:CHANGE
# CHANGE
DOMAIN_CLIENT=https://chat.example-company.com
# CHANGE
DOMAIN_SERVER=https://chat.example-company.com
TRUST_PROXY=1
NO_INDEX=true
# nginx publishes ports 80/443 on this internal address only. CHANGE
LAN_BIND_IP=10.0.0.20
# CHANGE
CHAT_HOSTNAME=chat.example-company.com
# CHANGE
ADMIN_HOSTNAME=chat-admin.example-company.com
# The only site allowed to show LibreChat inside an iframe (the in-house web app). CHANGE
INHOUSE_APP_ORIGIN=https://app.example-company.com
# CHANGE
ADMIN_PANEL_URL=https://chat-admin.example-company.com
ADMIN_PANEL_SESSION_SECRET=
ADMIN_PANEL_SESSION_COOKIE_SECURE=true

#==============================#
# Sign-in: Entra ID only       #
#==============================#
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
# The first Entra ID sign-in creates the LibreChat account.
ALLOW_SOCIAL_REGISTRATION=true
ALLOW_PASSWORD_RESET=false
ALLOW_PASSKEY_LOGIN=false
# Accounts are removed by IT during offboarding, not by the user.
ALLOW_ACCOUNT_DELETION=false
ALLOW_SHARED_LINKS=false
ALLOW_SHARED_LINKS_PUBLIC=false

OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
# CHANGE <tenant-id> to the Entra tenant ID.
OPENID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OPENID_SESSION_SECRET=
OPENID_SCOPE="openid profile email offline_access"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL="Sign in with Microsoft"
OPENID_AUTO_REDIRECT=true
OPENID_EMAIL_CLAIM=upn
# Reuse Entra ID tokens: needed for the SharePoint picker and for Graph tokens sent to MCP servers.
OPENID_REUSE_TOKENS=true
OPENID_USE_END_SESSION_ENDPOINT=true
# Only people assigned the app role can sign in. IT admins get the admin role.
OPENID_REQUIRED_ROLE=LibreChat.User
OPENID_REQUIRED_ROLE_TOKEN_KIND=id
OPENID_REQUIRED_ROLE_PARAMETER_PATH=roles
OPENID_ADMIN_ROLE=LibreChat.Admin
OPENID_ADMIN_ROLE_TOKEN_KIND=id
OPENID_ADMIN_ROLE_PARAMETER_PATH=roles
# Multi-factor sign-in is enforced in Entra ID with a Conditional Access policy
# on this app (see docs/entra-id-setup.md), not in LibreChat.

#==============================#
# SharePoint file picker       #
#==============================#
ENABLE_SHAREPOINT_FILEPICKER=true
# CHANGE
SHAREPOINT_BASE_URL=https://example-company.sharepoint.com
# CHANGE
SHAREPOINT_PICKER_SHAREPOINT_SCOPE=https://example-company.sharepoint.com/AllSites.Read
SHAREPOINT_PICKER_GRAPH_SCOPE=Files.Read.All

#==============================#
# Graph token for MCP servers  #
#==============================#
# Delegated scopes LibreChat requests (on-behalf-of) for {{LIBRECHAT_GRAPH_ACCESS_TOKEN}}.
# Mail.ReadWrite is needed to save drafts. Mail.Send is deliberately NOT requested.
GRAPH_API_SCOPES="https://graph.microsoft.com/Mail.ReadWrite https://graph.microsoft.com/Calendars.Read"

#==============================#
# Approved providers and models#
#==============================#
# Keys are stored on this server only (never "user_provided").
# Custom endpoints such as Grok (xAI) come from librechat.yaml.
ENDPOINTS=anthropic,openAI,custom,agents
ANTHROPIC_API_KEY=
# CHANGE to the approved list
ANTHROPIC_MODELS=claude-opus-5,claude-sonnet-5
OPENAI_API_KEY=
# CHANGE to the approved list
OPENAI_MODELS=gpt-6-sol,gpt-6-luna
XAI_API_KEY=

#==============================#
# Secrets (generate each one)  #
#==============================#
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

#==============================#
# Logging                      #
#==============================#
CONSOLE_JSON=true
DEBUG_LOGGING=false

#==============================#
# Outlook connector switch     #
#==============================#
# Set to false and restart the outlook-drafts container to revoke the connector for everyone.
OUTLOOK_CONNECTOR_ENABLED=true

#==============================#
# Backups (scripts/backup.sh)  #
#==============================#
# CHANGE: off-server target
RESTIC_REPOSITORY=sftp:backup@nas.example-company.local:/librechat
RESTIC_PASSWORD_FILE=/root/.librechat-restic-pass
VECTORDB_USER=myuser
VECTORDB_NAME=mydatabase
